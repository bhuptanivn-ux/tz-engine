# Copy this file to .env.local for local development,
# and set the same values under Vercel Project Settings -> Environment Variables for deployment.

# Auto-filled by Vercel when you connect a Blob store to this project.
# For local dev, copy it from Vercel dashboard -> Storage -> your Blob store -> ".env.local" tab.
BLOB_READ_WRITE_TOKEN=

# Password required to use the /admin upload page. Pick your own value.
ADMIN_PASSWORD=change-me
