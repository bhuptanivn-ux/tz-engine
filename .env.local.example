# Copy to .env.local for local development. On Vercel, these are
# auto-injected once a Blob store is CONNECTED to the project (Storage tab
# -> the store -> Connect) -- creating a store isn't enough on its own; it
# also needs to be explicitly connected to each project that should read
# it, or API routes will report BLOB_STORE_ID/BLOB_READ_WRITE_TOKEN as
# unset even though the store itself exists and works fine.

BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
