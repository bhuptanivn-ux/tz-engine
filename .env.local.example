# Copy to .env.local for local development. On Vercel, these three are
# normally auto-injected once a Blob store is connected to the project --
# double check the store's connection covers Preview and Development
# environments too, not just Production, if API routes report
# BLOB_STORE_ID/BLOB_READ_WRITE_TOKEN as unset on a preview deployment.

BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
